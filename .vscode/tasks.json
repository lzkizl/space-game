            "isBackground": true,
            "problemMatcher": [],
            "presentation": { "reveal": "always", "panel": "dedicated", "group": "collecte" }
        },
        {
            "label": "Collecte : mots FR + EN",
            "dependsOn": ["Mots français", "Mots anglais"],
            "dependsOrder": "parallel",
            "problemMatcher": [],
            "group": { "kind": "build", "isDefault": true }
        }
    ]
